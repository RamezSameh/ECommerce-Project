{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=ECommerceDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Cache": {
    "Redis": {
      // Empty = transparent in-memory fallback (RedisCacheService uses InMemoryCacheService instead)
      "ConnectionString": ""
    }
  },
  "Jwt": {
    "Key": "THIS_IS_MY_SUPER_SECRET_KEY_123456",
    "Issuer": "MyApp",
    "Audience": "MyAppUsers",
    "DurationInMinutes": 60
  },
  "Payment": {
    "Stripe": {
      "SecretKey": "",
      "WebhookSecret": ""
    }
  },
  "Email": {
    "Smtp": {
      "Host": "smtp.example.com",
      "Port": 587,
      "Username": "your-smtp-username",
      "Password": "your-smtp-password",
      "FromName": "ECommerce",
      "FromAddress": "no-reply@example.com",
      "EnableSsl": true,
      "UseDefaultCredentials": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ImageStorage": {
    "Provider": "Local",
    "Cloudinary": {
      "CloudName": "",
      "ApiKey": "",
      "ApiSecret": "",
      "Folder": "ecommerce"
    }
  }
}
