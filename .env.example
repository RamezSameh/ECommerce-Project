# Copy this file to .env and set your secrets
JWT_KEY=THIS_IS_MY_SUPER_SECRET_KEY_123456
STRIPE_SECRET_KEY=sk_test_... 
STRIPE_WEBHOOK_SECRET=whsec_...
DB_CONNECTION_STRING=Server=localhost;Database=ECommerceDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True
# Redis connection string — leave empty to use the transparent in-memory cache fallback
REDIS_CONNECTION_STRING=

# Image storage: "Local" or "Cloudinary"
IMAGE_STORAGE_PROVIDER=Local
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=ecommerce

# SMTP email settings (maps to the Email:Smtp config section)
Email__Smtp__Host=smtp.example.com
Email__Smtp__Port=587
Email__Smtp__Username=your-smtp-username
Email__Smtp__Password=your-smtp-password
Email__Smtp__FromName=ECommerce
Email__Smtp__FromAddress=no-reply@example.com
Email__Smtp__EnableSsl=true
Email__Smtp__UseDefaultCredentials=false
